{
  "name": "cloze",
  "account_id": "452c33847cf5cb1e46f391fca32fd1b5",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "IDENTITY",
      "service": "cail-doorway",
      "entrypoint": "WorkerIdentity",
      "props": {
        "id": "cloze",
        "worker": "cloze",
        "workspace": true
      }
    },
    {
      "binding": "WORKSPACE",
      "service": "cail-work-accounts"
    },
    {
      "binding": "WORK_ACCOUNTS",
      "service": "cail-work-accounts",
      "entrypoint": "WorkerAccounts",
      "props": {
        "id": "cloze",
        "worker": "cloze",
        "version": 1,
        "name": "Cloze Reader",
        "description": "Read a passage and restore its missing words.",
        "kind": "exercise",
        "href": "/",
        "resumePath": "/",
        "workerRoutes": true
      }
    }
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMIT",
      "namespace_id": "74105",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://cloze.ailab-452.workers.dev",
    "APP_ID": "cloze",
    "RELEASE": "dev",
    "LEGACY_ORIGIN": "https://reader.inference-arcade.com",
    "CLOZE_MODEL": "@cf/google/gemma-4-26b-a4b-it"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "LEGACY_DB",
      "database_name": "cloze-reader-db",
      "database_id": "9703849b-cfe7-401e-896f-edaba8a70f33"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
